ssh_public_key_path = "/Users/USERNAME/.ssh/id_ed25519.pub"

tenancy_ocid = "ocid1.tenancy.oc1..XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Restrict public API endpoint access
api_public_allowed_cidrs = ["YOUR.PUBLIC.IP/32"]

# Public DNS is no longer published on the NLB (Pi-hole is reached over the tailnet).

# Optional overrides to avoid CIDR overlap
vcn_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.0.0/24"
private_subnet_cidr = "10.0.1.0/24"

# Deploy to another region if needed
region = "us-ashburn-1"

# OKE worker nodes (shape: VM.Standard.A1.Flex, 2 OCPU / 12 GB each in modules/oke)
node_pool_size = 1

# PostgreSQL backup bucket configuration
backup_bucket_name    = "sitio-production-backups"
backup_retention_days = 90
